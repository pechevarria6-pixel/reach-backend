# ─── E2E sign-in, for Clerk's testing helpers ───────────────────────────
# Copy to .env.test.local (git ignores it) and fill in. Names only here —
# never commit a value.
#
# global.setup.ts reads these and checks the publishable key against the one
# the site under test actually serves, so keys for the wrong Clerk instance
# fail loudly instead of signing nobody in. tests/auth.setup.ts then signs
# each account in with a one-time token (no password typed or stored) and
# saves playwright/.auth/session.json and session2.json.
#
# The keys for www.alcanzar.io are the PRODUCTION instance's (pk_live_ /
# sk_live_): Clerk dashboard → the production instance → API keys. The
# development keys in .env.local belong to a different instance and cannot
# sign anybody in to production.
E2E_CLERK_PUBLISHABLE_KEY=
E2E_CLERK_SECRET_KEY=

# The two QA accounts. Both must already exist (the suite never creates
# accounts) and both must be members of the QA test group
# a9eba014-12cd-4220-af31-4442aa5a192b — the first as its admin.
TEST_EMAIL=
TEST_EMAIL_2=

# Optional: point the suite somewhere other than production.
# TEST_URL=https://www.alcanzar.io

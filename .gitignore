# Secrets — NEVER commit these
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# Next.js
.next/
out/
build/

# Node
# No trailing slash: a symlink named node_modules is not a directory, so
# "node_modules/" did not match one and git tracked a link to a local absolute
# path — which then shipped to production.
node_modules
npm-debug.log*

# Supabase
.supabase/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
.idea/

# Logs
*.log

# Certificates
*.pem
*.key
*.cert
.vercel
.env*

# TypeScript incremental build cache
tsconfig.tsbuildinfo

# Session written by tests/auth.setup.ts on every run — a live login, never commit it
playwright/.auth/session.json

# Scratch from the world-data build; never committed
.p1tmp/

# Geofabrik downloads when the map load is run by hand
.pbf/
